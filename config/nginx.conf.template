worker_processes 1;
daemon off;
pid "{{ROOT}}/tmp/nginx.pid";
error_log "{{ROOT}}/logs/nginx_error.log" warn;

events {
    worker_connections 1024;
}

http {
    include "{{ROOT}}/config/mime.types";
    default_type application/octet-stream;

    access_log "{{ROOT}}/logs/nginx_access.log";
    client_body_temp_path "{{ROOT}}/tmp/nginx_client_body";
    proxy_temp_path "{{ROOT}}/tmp/nginx_proxy";
    fastcgi_temp_path "{{ROOT}}/tmp/nginx_fastcgi";

    sendfile on;
    tcp_nopush on;
    tcp_nodelay on;
    keepalive_timeout 65;
    client_max_body_size 128M;

    server {
        listen {{PORT}};
        server_name 127.0.0.1 localhost;
        root "{{APP_DIR}}";
        index index.php index.html;

        location = /favicon.ico {
            log_not_found off;
            access_log off;
        }

        location = /robots.txt {
            allow all;
            log_not_found off;
            access_log off;
        }

        # Deny hidden files
        location ~ /\. {
            deny all;
        }

        # Deny sensitive directories
        location ~ ^/(app|bin|cache|classes|config|controllers|docs|localization|override|src|tests|tools|translations|travis-scripts|vendor)/ {
            deny all;
        }

        # Deny sensitive files
        location ~ \.(yml|yaml|twig|env|tpl|sql|log)$ {
            deny all;
        }

        # PrestaShop URL rewriting for images and api
        rewrite ^/api/?(.*)$ /webservice/dispatcher.php?url=$1 last;
        rewrite ^/([0-9])(-[_a-zA-Z0-9-]*)?(-[0-9]+)?/.+\.jpg$ /img/p/$1/$1$2$3.jpg last;
        rewrite ^/([0-9])([0-9])(-[_a-zA-Z0-9-]*)?(-[0-9]+)?/.+\.jpg$ /img/p/$1/$2/$1$2$3$4.jpg last;
        rewrite ^/([0-9])([0-9])([0-9])(-[_a-zA-Z0-9-]*)?(-[0-9]+)?/.+\.jpg$ /img/p/$1/$2/$3/$1$2$3$4$5.jpg last;
        rewrite ^/([0-9])([0-9])([0-9])([0-9])(-[_a-zA-Z0-9-]*)?(-[0-9]+)?/.+\.jpg$ /img/p/$1/$2/$3/$4/$1$2$3$4$5$6.jpg last;
        rewrite ^/c/([0-9]+)(-[.*_a-zA-Z0-9-]*)(-[0-9]+)?/.+\.jpg$ /img/c/$1$2$3.jpg last;
        rewrite ^/c/([a-zA-Z_-]+)(-[0-9]+)?/.+\.jpg$ /img/c/$1$2.jpg last;

        # Standard PrestaShop routing
        location / {
            try_files $uri $uri/ /index.php$is_args$args;
        }

        # FastCGI pass to PHP-CGI
        # NOTE: this regex location must stay BEFORE the back-office
        # location below, so *.php files are never served as static text.
        location ~ [^/]\.php(/|$) {
            fastcgi_split_path_info ^(.+?\.php)(/.*)$;
            if (!-f $document_root$fastcgi_script_name) {
                return 404;
            }

            fastcgi_index index.php;
            include "{{ROOT}}/config/fastcgi.conf";
            fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
            fastcgi_param PATH_INFO $fastcgi_path_info;
            fastcgi_param HTTP_PROXY "";

            # FastCGI Timeouts (prevent premature 504 Gateway Timeout during installer)
            fastcgi_connect_timeout 600s;
            fastcgi_send_timeout 600s;
            fastcgi_read_timeout 600s;

            # FastCGI Buffers (prevent buffer exhaustion during large module unpacking/demo responses)
            fastcgi_buffer_size 128k;
            fastcgi_buffers 8 128k;
            fastcgi_busy_buffers_size 256k;
            fastcgi_temp_file_write_size 256k;

            fastcgi_pass 127.0.0.1:{{PHP_PORT}};
        }

        # PrestaShop 9 back office uses Symfony pretty URLs without .php
        # (e.g. /admin_abc123/login). Without this, such requests fall
        # through location / into the front-office /index.php (bug: admin
        # login opened the shop instead). Generic regex covers any
        # current or future admin directory name, no restart needed
        # after the installer renames admin/. Also covers /admin-api/.
        location ~ ^/admin[^/]*/ {
            try_files $uri $uri/ @prestashop_bo;
        }

        location @prestashop_bo {
            rewrite ^/(admin[^/]*)(/.*)?$ /$1/index.php$2 last;
        }
    }
}
